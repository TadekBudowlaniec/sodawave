## Mail transport (SMTP)
# Example for most SMTP providers:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_user@example.com
SMTP_PASS=your_password_or_app_password

## Where emails should be delivered
MAIL_TO=sodawave@sodawave.pl

## Optional: customize From:
# MAIL_FROM_NAME=SodaWave
# MAIL_FROM_EMAIL=no-reply@sodawave.pl

## Mail server port (dev)
MAIL_SERVER_PORT=5174

## CORS — dozwolone originy (oddzielone przecinkami)
CORS_ORIGIN=https://sodawave.pl

